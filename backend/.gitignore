**/*obj\\Debug*

# Environments / Secrets (do not commit machine-local secrets)
.env
.env.*
secrets.json
**/appsettings.Local.json
**/appsettings.*.local.json
**/appsettings.Secrets.json

# Environment files (may contain tokens, keys, passwords)
.env
.env.*
!.env.example
*.env.local
*.env.production

# HTTP test files (may contain JWT tokens, API keys)
*.http
*.rest

# Docker sensitive files
docker-compose.override.yml
docker-compose.prod.yml

