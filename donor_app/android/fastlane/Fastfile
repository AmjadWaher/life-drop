default_platform(:android)

platform :android do
  desc "Lane for Android Firebase App Distribution"
  lane :firebase_distribution do
    sh "flutter clean"
    sh "flutter build apk --release --flavor production --target lib/main_production.dart --no-tree-shake-icons"
    firebase_app_distribution(
      app: "1:410985759916:android:d8cddf9efe6920b3d30b09",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-production-release.apk",
      # testers: "amjadwaher623@gmail.com",
      groups: "team",
      release_notes: """
✨ New Features
• Donation Cancellation: Users can now cancel active donations with reason selection, optional notes, and impact warnings.Includes a new cancel donation screen and full UI flow.
• Automatic Token Refresh: Added interceptor for seamless token renewal on 401 errors, improving auth reliability.
• Enhanced UI Components: Refactored active donation widgets for better organization and responsiveness. Added localized labels and improved dropdowns.

🔧 Improvements
• Networking: Migrated to token-based auth models for better security. Unified API error handling with mixins.
• Localization: Added comprehensive strings for cancellation flows, UI elements, and error messages in Arabic and English.
• Code Quality: Replaced direct snack bar calls with reusable mixins. Moved widgets to subfolders for cleaner architecture.
• User Experience: Improved loading states, error messages, and form validations.

🐛 Bug Fixes
• Fixed biometric login checks to ensure tokens are saved before enabling.
• Resolved issues with widget imports and state management in donation screens.

⚙️ Technical Changes
• Removed deprecated SafeApiCallMixin and old login models.
• Updated dependencies and routing for new features.
• Enhanced Crashlytics logging for better error tracking.""",
    )
  end
end
