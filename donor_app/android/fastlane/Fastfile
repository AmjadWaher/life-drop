default_platform(:android)

platform :android do
  desc "Lane for Android Firebase App Distribution"
  lane :firebase_distribution do
    sh "flutter clean"
    sh "flutter build apk --release --flavor production --target lib/main_production.dart --no-tree-shake-icons"
    firebase_app_distribution(
      app: "1:410985759916:android:d8cddf9efe6920b3d30b09",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-production-release.apk",
      # testers: "amjadwaher623@gmail.com",
      groups: "team",
      release_notes: """🚀 New Features:
• Donation Requests System - View and manage active donation requests
• Active Donation Tracking - Monitor current accepted donations with hospital details
• Cancellation Management - Cancel donations with predefined reasons and notes
• Enhanced Blood Type Handling - Improved blood type selection across the app

🔧 Improvements:
• Unified API Error Handling - Better error logging and user feedback
• Code Organization - Moved shared enums to core module
• Dependency Injection Updates - Cleaner service registration
• Performance - Removed unused development files and examples

🐛 Bug Fixes:
• Fixed blood type import paths after enum relocation
• Updated authentication datasource references""",
    )
  end
end
