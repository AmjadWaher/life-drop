default_platform(:android)

platform :android do
  desc "Lane for Android Firebase App Distribution"
  lane :firebase_distribution do
    sh "flutter clean"
    sh "flutter build apk --release --flavor production --target lib/main_production.dart --no-tree-shake-icons"
    firebase_app_distribution(
      app: "1:410985759916:android:d8cddf9efe6920b3d30b09",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-production-release.apk",
      # testers: "amjadwaher623@gmail.com",
      groups: "team",
      release_notes: """✨ New Features
Active Donation Tracking Screen

New dedicated tab in main navigation to view active donation requests in real-time
Live countdown timer showing request expiration with visual progress bar
Map integration displaying hospital location with glassmorphic ETA overlay
Quick-access buttons: "Contact Hospital" and "Cancel Donation"
Hospital summary card showing blood type, units needed, and urgency level
Real-time status header with "Donation in Progress" display""",
    )
  end
end
